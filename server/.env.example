# Server Production Environment Configuration Template
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database Configuration (PostgreSQL on Oracle Cloud VM or Cloud DB)
DATABASE_URL=postgresql://app_user:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:5432/app_db
DATABASE_SSL=false

# Security & CORS Whitelist (comma-separated origins)
CLIENT_ORIGIN=https://app.example.com,https://kids-english-agent.pages.dev
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_KEY_MINIMUM_32_BYTES
